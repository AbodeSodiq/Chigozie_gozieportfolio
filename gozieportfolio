}

/*==========================
     NAVBAR ON SCROLL
==========================*/

.navbar.scrolled{

    background:rgba(10,17,40,.45);

    backdrop-filter:blur(18px);

    box-shadow:0 10px 25px rgba(0,0,0,.25);

}
.nav-right{
    display:flex;
    align-items:center;
    gap:20px;
}

/*==========================
       MOBILE
==========================*/


@media(max-width:768px){

    .navbar{
        padding:0 20px;
    }

    .nav-right{
        gap:15px;
    }

    .menu-toggle{
        display:block;
    }

    .nav-links{
        position:absolute;
        top:80px;
        left:0;
        width:100%;

        display:flex;
        flex-direction:column;

        background:rgba(10,17,40,.95);
        backdrop-filter:blur(18px);

        max-height:0;
        overflow:hidden;

        transition:max-height .4s ease;
    }

    .nav-links.active{
        max-height:300px;
        padding:25px 0;
    }

    .project-btn{
        padding:10px 18px;
        font-size:14px;
    }

}

@media(max-width:480px){

    .project-btn{
        font-size:13px;
        padding:9px 14px;
    }

}














