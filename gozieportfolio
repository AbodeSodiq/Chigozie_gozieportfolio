.corporate-footer{
    width: 100%;
    background: rgb(4, 4, 26);
    padding: 55px 6% 25px;
    box-sizing: border-box;
    color: white;
}

.footer-top{
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
}

.footer-logo{
    color: white;
    text-decoration: none;
    font-size: 27px;
    font-weight: 700;
    letter-spacing: -1px;
}

.footer-logo span{
    color: #6BB8FF;
}


/* NAVIGATION */

.footer-links{
    display: flex;
    gap: 30px;
}

.footer-links a,
.footer-socials a{
    color: #858597;
    text-decoration: none;
    font-size: 14px;
    transition: .3s ease;
}

.footer-links a:hover,
.footer-socials a:hover{
    color: #6BB8FF;
}


/* SOCIALS */

.footer-socials{
    display: flex;
    gap: 20px;
}


/* DIVIDER */

.footer-line{
    width: 100%;
    height: 1px;
    background: rgba(255,255,255,.1);
    margin: 40px 0 22px;
}


/* BOTTOM */

.footer-bottom{
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.footer-bottom p{
    margin: 0;
    color: #686879;
    font-size: 13px;
}

.footer-bottom span{
    color: #8B5CF6;
}


/* ==========================
   MOBILE
========================== */

@media(max-width:768px){

    .corporate-footer{
        padding: 45px 7% 20px;
    }

    .footer-top{
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 25px;
    }

    .footer-links{
        flex-wrap: wrap;
        justify-content: center;
        gap: 18px 25px;
    }

    .footer-socials{
        justify-content: center;
        flex-wrap: wrap;
    }

    .footer-bottom{
        flex-direction: column;
        gap: 10px;
        text-align: center;
    }
}
        



















